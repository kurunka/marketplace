# ── Database ──────────────────────────────────────────────
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=market
# used by the backend container (host = service name "db")
DATABASE_URL=postgresql+asyncpg://market:market@db:5432/market

# ── Auth ──────────────────────────────────────────────────
# generate: py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Admin bootstrap (created by seed script) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ── Frontend ──────────────────────────────────────────────
# public API base as seen from the browser
NUXT_PUBLIC_API_BASE=http://localhost/api
